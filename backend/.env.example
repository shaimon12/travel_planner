# Application Configuration
PROJECT_NAME="AI Travel Planner Pro"
DEBUG=True
API_V1_STR="/api"
SECRET_KEY=change_this_to_a_secure_random_key_in_production


# Database Configuration
# Uses SQLite for zero-config local development, or PostgreSQL for production
DATABASE_URL=sqlite:///./travel_planner.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_planner

# AI Model Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS Configuration (allowed origins separated by comma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

